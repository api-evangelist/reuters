  "item": [
    {
      "id": "cf497d4d-0f55-4748-ae67-d9af881567f5",
      "name": "Authentication",
      "description": {
        "content": "Authenticate with Reuters Connect to obtain an authorization token. Tokens are required for all content API calls and should be cached and renewed periodically.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ec5b3f60-c867-435c-a098-ba44dcb86ad1",
          "name": "Authenticate and Obtain Authorization Token",
          "request": {
            "name": "Authenticate and Obtain Authorization Token",
            "description": {
              "content": "Authenticates with the Reuters Connect service using username and password credentials. Returns an authorization token that must be included in all subsequent API requests. Tokens should be cached and renewed periodically (typically every 3600 seconds). This endpoint uses the commerce.reuters.com authentication server.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "rmd",
                "rest",
                "xml",
                "login"
              ],
              "host": [
                "commerce",
                "reuters",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "(Required) The Reuters Connect account username for authentication."
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<password>",
                  "description": "(Required) The Reuters Connect account password for authentication."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
