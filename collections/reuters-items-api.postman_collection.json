                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "(Required) Authorization token obtained from the /login endpoint."
                },
                {
                  "disabled": false,
                  "key": "channel",
                  "value": "<string>",
                  "description": "(Required) The channel alias identifying which content channel to retrieve items from."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Maximum number of items to return in the response."
                },
                {
                  "disabled": false,
                  "key": "dateRange",
                  "value": "<string>",
                  "description": "Filter results by date range. Specify a date range to restrict results to items published within that period."
                },
                {
                  "disabled": false,
                  "key": "mediaType",
                  "value": "<string>",
                  "description": "Filter results by media type to restrict to specific content formats."
