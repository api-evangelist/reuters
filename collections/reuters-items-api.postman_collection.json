      "id": "544dc188-fa1a-45ff-bcc5-154cb794ec95",
      "name": "Items",
      "description": {
        "content": "Retrieve content items from specific channels. Items represent individual pieces of editorial content such as news stories, images, video clips, or graphics.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0dd0a4b1-c3fd-4360-8159-63efeb169eae",
          "name": "List Items on a Channel",
          "request": {
            "name": "List Items on a Channel",
            "description": {
              "content": "Retrieves a list of content items available on a specific channel. Returns the most recent items on the channel, including metadata such as headlines, timestamps, media types, and identifiers. Items can represent news stories, images, video clips, or graphics depending on the channel category.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "items"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
